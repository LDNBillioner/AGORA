# ╔══════════════════════════════════════════════════════════════════════════╗
# ║               AGORA AI Accountant — Environment Variables               ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Copy file ini ke .env dan isi semua nilai yang diperlukan.
# Jalankan: cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────
# 1. DATABASE (Supabase PostgreSQL) — ⚠️ WAJIB DIISI
# ─────────────────────────────────────────────────────────────────────────
# Cara mendapatkan:
#   1. Buka https://supabase.com → Buat project baru
#   2. Project Settings → Database → Connection String (URI)
#   3. Pilih "Transaction" mode (port 6543) atau "Session" mode (port 5432)
#   4. Ganti [YOUR-PASSWORD] dengan password database kamu
#
# Format: postgresql://postgres.[project-ref]:[password]@[host]:[port]/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─────────────────────────────────────────────────────────────────────────
# 2. GOOGLE GEMINI (LLM + Embeddings + STT) — ⚠️ WAJIB DIISI
# ─────────────────────────────────────────────────────────────────────────
# Cara mendapatkan:
#   1. Buka https://aistudio.google.com/apikey
#   2. Klik "Create API Key"
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# 4. META WHATSAPP CLOUD API — Isi setelah konfigurasi Meta Developer
# ─────────────────────────────────────────────────────────────────────────
# Cara mendapatkan:
#   1. Buka https://developers.facebook.com
#   2. Buat App → Pilih "Business" → Tambahkan product "WhatsApp"
#   3. WhatsApp → API Setup → Copy Token & Phone Number ID
#   4. META_VERIFY_TOKEN: token custom buatan sendiri (bebas), digunakan
#      untuk handshake webhook verification dengan Meta.
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_VERIFY_TOKEN=agora_verify_token_ganti_ini

# ─────────────────────────────────────────────────────────────────────────
# 5. INTERNAL (Jangan diubah kecuali deploy di server berbeda)
# ─────────────────────────────────────────────────────────────────────────
AGORA_ENGINE_URL=http://localhost:8000
