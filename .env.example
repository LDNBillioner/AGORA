# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Google Gemini (LLM + Embeddings + STT) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- NVIDIA NIM (Nemotron-OCR-v2) ---
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Meta WhatsApp Cloud API ---
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# --- Internal Engine URL ---
AGORA_ENGINE_URL=http://localhost:8000
